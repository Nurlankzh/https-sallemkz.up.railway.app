@dp.message(AdminStates.waiting_add_coins)
async def admin_addcoins_message(
    message: Message,
    state: FSMContext,
):
    if not is_admin(message.from_user.id):
        return

    parts = message.text.split()

    if len(parts) != 2:
        await message.answer(
            "❌ Формат дұрыс емес:\n"
            "<code>USER_ID AMOUNT</code>"
        )
        return

    try:
        user_id = int(parts[0])
        amount = int(parts[1])
    except ValueError:
        await message.answer(
            "❌ USER_ID және AMOUNT сан болуы керек."
        )
        return

    user = await get_user(user_id)

    if not user:
        await message.answer(
            "❌ User табылмады."
        )
        return

    await add_balance(
        user_id,
        amount,
    )

    await add_log(
        user_id,
        f"admin_add_coins:{amount}",
    )

    await message.answer(
        "✅ Coin қосылды.\n\n"
        f"👤 User: <code>{user_id}</code>\n"
        f"💰 +{amount}"
    )

    try:
        await message.bot.send_message(
            user_id,
            "🎁 <b>Сізге Coin берілді!</b>\n\n"
            f"💰 +{amount} Coin",
        )
    except Exception:
        pass

    await state.clear()


