# =========================================================
# START
# =========================================================


@dp.message(CommandStart())
async def start_handler(message: Message):
    user = message.from_user

    is_new = await create_user(
        user.id,
        user.username,
        user.first_name,
    )

    if is_new:
        args = message.text.split(maxsplit=1)

        inviter_id = 0

        if len(args) > 1:
            try:
                inviter_id = int(args[1])
            except ValueError:
                inviter_id = 0

        await process_referral(
            user.id,
            inviter_id,
        )

    if await check_banned(message):
        return

    await message.answer(
        "🚀 <b>VIDEO COIN BOT</b>\n\n"
        "Видео көріп Coin жинаңыз 💰\n"
        "Достарыңызды шақырып бонус алыңыз 👥\n"
        "Аноним чатта сөйлесіңіз 💬\n\n"
        "Төмендегі мәзірден таңдаңыз:",
        reply_markup=main_keyboard(),
    )


