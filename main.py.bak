# =========================================================
# ANONYMOUS MESSAGE RELAY
# =========================================================


@dp.message(
    F.text,
    ~CommandStart()
)
async def anonymous_text_handler(message: Message):
    if await check_banned(message):
        return

    partner = await get_partner(
        message.from_user.id
    )

    if not partner:
        return

    text = message.text[:MAX_MESSAGE_LENGTH]

    try:
        await message.bot.send_message(
            partner,
            "💬 <b>Аноним:</b>\n\n"
            f"{text}",
            reply_markup=chat_keyboard(),
        )

    except Exception as error:
        logging.exception(
            "Relay error: %s",
            error,
        )


