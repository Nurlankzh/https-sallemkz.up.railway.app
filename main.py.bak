@dp.callback_query(F.data == "withdraw")
async def withdraw_callback(
    callback: CallbackQuery,
    state: FSMContext,
):
    await callback.answer()

    await state.set_state(
        UserStates.waiting_withdraw
    )

    await state.update_data(
        mode="withdraw"
    )

    await callback.message.edit_text(
        "💸 <b>Coin шығару</b>\n\n"
        f"Минимум: <b>{MIN_WITHDRAW}</b> Coin\n\n"
        "Қанша Coin шығаратыныңызды жазыңыз.\n\n"
        "Бас тарту: /cancel"
    )


@dp.message(UserStates.waiting_withdraw)
async def withdraw_or_promo(
    message: Message,
    state: FSMContext,
):
    data = await state.get_data()
    mode = data.get("mode")

    if mode == "promo":
        code = message.text.strip().upper()

        promo = await db_execute(
            """
            SELECT code, amount, uses, max_uses, active
            FROM promo_codes
            WHERE code=?
            """,
            (code,),
            fetchone=True,
        )

        if not promo:
            await message.answer(
                "❌ Мұндай промокод жоқ."
            )
            await state.clear()
            return

        code_db, amount, uses, max_uses, active = promo

        if not active:
            await message.answer(
                "❌ Бұл промокод өшірілген."
            )
            await state.clear()
            return

        if max_uses > 0 and uses >= max_uses:
            await message.answer(
                "❌ Промокод лимиті біткен."
            )
            await state.clear()
            return

        used = await db_execute(
            """
            SELECT 1
            FROM promo_used
            WHERE user_id=? AND code=?
            """,
            (
                message.from_user.id,
                code_db,
            ),
            fetchone=True,
        )

        if used:
            await message.answer(
                "❌ Сіз бұл промокодты бұрын қолдандыңыз."
            )
            await state.clear()
            return

        await db_execute(
            """
            INSERT INTO promo_used(user_id, code)
            VALUES (?, ?)
            """,
            (
                message.from_user.id,
                code_db,
            ),
        )

        await db_execute(
            """
            UPDATE promo_codes
            SET uses=uses+1
            WHERE code=?
            """,
            (code_db,),
        )

        await add_balance(
            message.from_user.id,
            amount,
        )

        await message.answer(
            "🎉 <b>Промокод қабылданды!</b>\n\n"
            f"💰 +{amount} Coin",
            reply_markup=main_keyboard(),
        )

        await state.clear()
        return

    if mode == "withdraw":
        try:
            amount = int(message.text.strip())
        except ValueError:
            await message.answer(
                "❌ Сан енгізіңіз."
            )
            return

        if amount < MIN_WITHDRAW:
            await message.answer(
                f"❌ Минимум {MIN_WITHDRAW} Coin."
            )
            return

        user = await get_user(
            message.from_user.id
        )

        balance = user[3] if user else 0

        if balance < amount:
            await message.answer(
                "❌ Балансыңыз жеткіліксіз."
            )
            await state.clear()
            return

        await remove_balance(
            message.from_user.id,
            amount,
        )

        await db_execute(
            """
            INSERT INTO withdrawals(
                user_id,
                amount,
                status,
                created_at
            )
            VALUES (?, ?, 'pending', ?)
            """,
            (
                message.from_user.id,
                amount,
                datetime.now().isoformat(),
            ),
        )

        await message.answer(
            "✅ <b>Өтінім қабылданды.</b>\n\n"
            f"💰 Сома: {amount} Coin\n"
            "⏳ Статус: Күтілуде.\n\n"
            "Администратор өтінімді қарайды.",
            reply_markup=main_keyboard(),
        )

        if ADMIN_ID:
            try:
                await message.bot.send_message(
                    ADMIN_ID,
                    "💸 <b>Жаңа шығару өтінімі!</b>\n\n"
                    f"👤 User: <code>{message.from_user.id}</code>\n"
                    f"💰 Amount: <b>{amount}</b> Coin",
                )
            except Exception:
                pass

        await state.clear()


