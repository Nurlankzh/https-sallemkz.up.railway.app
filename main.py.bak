@dp.message(AdminStates.waiting_promo_code)
async def admin_promo_code(
    message: Message,
    state: FSMContext,
):
    if not is_admin(message.from_user.id):
        return

    code = message.text.strip().upper()

    if len(code) < 3:
        await message.answer(
            "❌ Код тым қысқа."
        )
        return

    await state.update_data(
        promo_code=code
    )

    await state.set_state(
        AdminStates.waiting_promo_amount
    )

    await message.answer(
        "💰 Осы промокод қанша Coin берсін?\n\n"
        "Мысалы: <code>100</code>"
    )


@dp.message(AdminStates.waiting_promo_amount)
async def admin_promo_amount(
    message: Message,
    state: FSMContext,
):
    if not is_admin(message.from_user.id):
        return

    try:
        amount = int(message.text.strip())
    except ValueError:
        await message.answer(
            "❌ Сан енгізіңіз."
        )
        return

    if amount <= 0:
        await message.answer(
            "❌ Amount 0-ден үлкен болуы керек."
        )
        return

    data = await state.get_data()
    code = data["promo_code"]

    await db_execute(
        """
        INSERT OR REPLACE INTO promo_codes(
            code,
            amount,
            uses,
            max_uses,
            active,
            created_at
        )
        VALUES (?, ?, 0, 0, 1, ?)
        """,
        (
            code,
            amount,
            datetime.now().isoformat(),
        ),
    )

    await message.answer(
        "✅ <b>Промокод жасалды!</b>\n\n"
        f"🎟 Код: <code>{code}</code>\n"
        f"💰 Сыйлық: <b>{amount} Coin</b>"
    )

    await state.clear()


# =========================================================
# ADMIN HOME
# =========================================================


@dp.callback_query(F.data == "admin_home")
async def admin_home_callback(
    callback: CallbackQuery,
):
    if not is_admin(callback.from_user.id):
        await callback.answer(
            "🚫 Рұқсат жоқ!",
            show_alert=True,
        )
        return

    await callback.answer()

    await callback.message.edit_text(
        "👑 <b>ADMIN PANEL</b>",
        reply_markup=admin_keyboard(),
    )


# =========================================================
# ADMIN COMMANDS
# =========================================================


@dp.message(Command("users"))
async def users_command(message: Message):
    if not is_admin(message.from_user.id):
        return

    row = await db_execute(
        "SELECT COUNT(*) FROM users",
        fetchone=True,
    )

    await message.answer(
        f"👥 Барлық қолданушы: <b>{row[0]}</b>"
    )


@dp.message(Command("videos"))
async def videos_command(message: Message):
    if not is_admin(message.from_user.id):
        return

    count = await get_video_count()

    await message.answer(
        f"🎬 Белсенді видео: <b>{count}</b>"
    )


@dp.message(Command("balance"))
async def admin_balance_command(message: Message):
    user = await get_user(message.from_user.id)

    if not user:
        return

    await message.answer(
        f"💰 Баланс: <b>{user[3]} Coin</b>"
    )


# =========================================================
# UNKNOWN COMMAND
# =========================================================


@dp.message(F.text.startswith("/"))
async def unknown_command(message: Message):
    if await check_banned(message):
        return

    await message.answer(
        "❓ Белгісіз команда.\n\n"
        "🏠 /start басыңыз."
    )


# =========================================================
# ERROR HANDLER
# =========================================================


@dp.error()
async def error_handler(event):
    logging.exception(
        "Unhandled bot error: %s",
        event.exception,
    )


# =========================================================
# MAIN
# =========================================================


async def main():
    print("========================================")
    print("🚀 VIDEO + COIN + ANONYMOUS CHAT BOT")
    print("========================================")
    print(f"👑 ADMIN_ID: {ADMIN_ID}")

    await init_db()

    bot = Bot(
        token=BOT_TOKEN
    )

    try:
        await bot.delete_webhook(
            drop_pending_updates=True
        )

        print("🟢 Webhook өшірілді")
        print("🟢 BOT STARTED")

        await dp.start_polling(bot)

    finally:
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())