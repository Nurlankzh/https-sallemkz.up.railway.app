    )


# =========================================================
# DAILY
# =========================================================


@dp.callback_query(F.data == "daily")
async def daily_callback(callback: CallbackQuery):
    await callback.answer()

    if await is_banned(callback.from_user.id):
        return

    success, amount = await claim_daily(
        callback.from_user.id
    )

    if success:
        text = (
            "🎉 <b>Күнделікті бонус алынды!</b>\n\n"
            f"💰 +{amount} Coin"
        )
    else:
        text = (
            "⏳ <b>Бүгін бонус алып қойдыңыз.</b>\n\n"
            "Ертең қайта келіңіз."
        )

    await callback.message.edit_text(
        text,
        reply_markup=main_keyboard(),
    )


# =========================================================
# STATS
# =========================================================


@dp.callback_query(F.data == "stats")
async def stats_callback(callback: CallbackQuery):
    await callback.answer()

    user = await get_user(callback.from_user.id)

    if not user:
        return

    balance = user[3]
    referrals = user[4]
    watched = user[5]

    total_videos = await get_video_count()
    watched_cycle = await get_watched_count(
        callback.from_user.id
    )

    await callback.message.edit_text(
        "📊 <b>Статистика</b>\n\n"
        f"🪙 Баланс: <b>{balance}</b>\n"
        f"🎬 Барлық көрген видео: <b>{watched}</b>\n"
        f"🔄 Осы цикл: <b>{watched_cycle}/{total_videos}</b>\n"
        f"👥 Реферал: <b>{referrals}</b>",
        reply_markup=main_keyboard(),
    )


# =========================================================
# VIDEO
# =========================================================


@dp.callback_query(F.data == "watch")
async def watch_callback(callback: CallbackQuery):
    await callback.answer()

    user_id = callback.from_user.id

    if await is_banned(user_id):
        return

    total = await get_video_count()

    if total == 0:
        await callback.message.edit_text(
            "🎬 <b>Қазір видео жоқ.</b>\n\n"
            "Администратор видео қосқанын күтіңіз.",
            reply_markup=main_keyboard(),
        )
        return

    video = await get_next_video(user_id)

    new_cycle = False

    if not video:
        await reset_watched(user_id)

        video = await get_next_video(user_id)

        new_cycle = True

    if not video:
        await callback.message.edit_text(
            "❌ Видео табылмады.",
            reply_markup=main_keyboard(),
        )
        return

    video_id, file_id, title = video

    # Reward immediately after sending.
    # Telegram bot cannot reliably verify full video watching.
    rewarded = await mark_video_watched(
        user_id,
        video_id,
    )

    reward_text = ""

    if rewarded:
        reward_text = f"\n\n💰 <b>+{VIDEO_REWARD} Coin</b>"

    if new_cycle:
        cycle_text = (
            "🔄 <b>Жаңа цикл басталды!</b>\n\n"
        )
    else:
        cycle_text = ""

    caption = (
        f"🎬 <b>{title or 'Видео'}</b>\n\n"
        f"{cycle_text}"
        f"Видео ID: <code>{video_id}</code>"
        f"{reward_text}"
    )

    try:
        await callback.message.answer_video(
            video=file_id,
            caption=caption,
            reply_markup=video_keyboard(),
        )

        await callback.message.delete()

    except Exception as error:
        logging.exception(
            "Video send error: %s",
            error,
        )


