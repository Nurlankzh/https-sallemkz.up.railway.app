@dp.callback_query(F.data == "referral")
async def referral_callback(callback: CallbackQuery):
    await callback.answer()

    bot = callback.bot

    me = await bot.get_me()

    link = (
        f"https://t.me/{me.username}"
        f"?start={callback.from_user.id}"
    )

    await callback.message.edit_text(
        "👥 <b>Дос шақыру</b>\n\n"
        f"Әр шақырған досыңыз үшін "
        f"<b>+{REFERRAL_REWARD} Coin</b> аласыз.\n\n"
        "🔗 Сіздің сілтемеңіз:\n"
        f"<code>{link}</code>",
        reply_markup=main_keyboard(),
    )


# =========================================================
# ANONYMOUS CHAT
# =========================================================


async def start_anonymous_chat(bot: Bot, user_id: int):
    partner = await get_partner(user_id)

    if partner:
        return partner

    waiting = await find_waiting_user(user_id)

    if waiting:
        await create_chat(
            user_id,
            waiting,
        )

        try:
            await bot.send_message(
                waiting,
                "💬 <b>Сізге жаңа адам табылды!</b>\n\n"
                "Аноним чат басталды.",
                reply_markup=chat_keyboard(),
            )
        except Exception:
            pass

        return waiting

    await add_to_queue(user_id)

    return None


@dp.callback_query(F.data == "anon")
async def anon_callback(callback: CallbackQuery):
    await callback.answer()

    user_id = callback.from_user.id

    if await is_banned(user_id):
        return

    partner = await start_anonymous_chat(
        callback.bot,
        user_id,
    )

    if partner:
        text = (
            "💬 <b>Аноним чат қосылды!</b>\n\n"
            "Сізге кездейсоқ адам табылды.\n"
            "Жазыңыз — хабарламаңыз аноним түрде жеткізіледі."
        )
    else:
        text = (
            "🔎 <b>Адам ізделуде...</b>\n\n"
            "Біреу қосылған кезде чат автоматты түрде басталады."
        )

    await callback.message.edit_text(
        text,
        reply_markup=chat_keyboard(),
    )


