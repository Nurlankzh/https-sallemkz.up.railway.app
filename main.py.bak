# =========================================================
# CONFIG
# =========================================================

BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()

if not BOT_TOKEN:
    raise RuntimeError(
        "❌ BOT_TOKEN жоқ!\n"
        "Constructor runner BOT_TOKEN айнымалысын бермеген."
    )

try:
    ADMIN_ID = int(os.getenv("ADMIN_ID", "0"))
except ValueError:
    ADMIN_ID = 0

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"
VIDEO_DIR = DATA_DIR / "videos"
DB_PATH = DATA_DIR / "bot.db"

DATA_DIR.mkdir(parents=True, exist_ok=True)
VIDEO_DIR.mkdir(parents=True, exist_ok=True)

# =========================================================
# SETTINGS
# =========================================================

VIDEO_REWARD = 1
START_BONUS = 3
DAILY_BONUS = 5
REFERRAL_REWARD = 5

MIN_WITHDRAW = 100
MAX_MESSAGE_LENGTH = 4000

dp = Dispatcher()

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

# =========================================================
# FSM
# =========================================================


class AdminStates(StatesGroup):
    waiting_video = State()
    waiting_broadcast = State()
    waiting_add_coins = State()
    waiting_remove_coins = State()
    waiting_ban = State()
    waiting_unban = State()
    waiting_promo_code = State()
    waiting_promo_amount = State()


class UserStates(StatesGroup):
    waiting_withdraw = State()


# =========================================================
# DATABASE
# =========================================================


async def db_execute(query, params=(), fetch=False, fetchone=False):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("PRAGMA busy_timeout=5000")
        cursor = await db.execute(query, params)

        if fetchone:
            result = await cursor.fetchone()
            await db.close()
            return result

        if fetch:
            result = await cursor.fetchall()
            await db.close()
            return result

        await db.commit()


async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("PRAGMA journal_mode=WAL")
        await db.execute("PRAGMA busy_timeout=5000")

        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                balance INTEGER DEFAULT 0,
                referrals INTEGER DEFAULT 0,
                videos_watched INTEGER DEFAULT 0,
                is_banned INTEGER DEFAULT 0,
                created_at TEXT,
                last_daily TEXT
            )
        """)

        # Migration
        cursor = await db.execute("PRAGMA table_info(users)")
        columns = {row[1] for row in await cursor.fetchall()}

        migrations = {
            "username": "ALTER TABLE users ADD COLUMN username TEXT",
            "first_name": "ALTER TABLE users ADD COLUMN first_name TEXT",
            "balance": "ALTER TABLE users ADD COLUMN balance INTEGER DEFAULT 0",
            "referrals": "ALTER TABLE users ADD COLUMN referrals INTEGER DEFAULT 0",
            "videos_watched": (
                "ALTER TABLE users ADD COLUMN videos_watched INTEGER DEFAULT 0"
            ),
            "is_banned": (
                "ALTER TABLE users ADD COLUMN is_banned INTEGER DEFAULT 0"
            ),
            "created_at": (
                "ALTER TABLE users ADD COLUMN created_at TEXT"
            ),
            "last_daily": (
                "ALTER TABLE users ADD COLUMN last_daily TEXT"
            ),
        }

        for column, sql in migrations.items():
            if column not in columns:
                await db.execute(sql)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS videos (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                file_id TEXT NOT NULL,
                title TEXT,
                active INTEGER DEFAULT 1,
                created_at TEXT
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS watched_videos (
                user_id INTEGER NOT NULL,
                video_id INTEGER NOT NULL,
                watched_at TEXT,
                PRIMARY KEY(user_id, video_id)
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS referrals (
                user_id INTEGER PRIMARY KEY,
                invited_by INTEGER
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS anonymous_queue (
                user_id INTEGER PRIMARY KEY,
                created_at TEXT
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS anonymous_chats (
                user_id INTEGER PRIMARY KEY,
                partner_id INTEGER NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS promo_codes (
                code TEXT PRIMARY KEY,
                amount INTEGER NOT NULL,
                uses INTEGER DEFAULT 0,
                max_uses INTEGER DEFAULT 0,
                active INTEGER DEFAULT 1,
                created_at TEXT
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS promo_used (
                user_id INTEGER NOT NULL,
                code TEXT NOT NULL,
                PRIMARY KEY(user_id, code)
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS withdrawals (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                amount INTEGER NOT NULL,
                status TEXT DEFAULT 'pending',
                created_at TEXT
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                action TEXT,
                created_at TEXT
            )
        """)

        await db.commit()

    print("🟢 Database дайын")


# =========================================================
# LOG
# =========================================================


async def add_log(user_id, action):
    try:
        await db_execute(
            """
            INSERT INTO logs(user_id, action, created_at)
            VALUES (?, ?, ?)
            """,
            (
                user_id,
                action,
                datetime.now().isoformat(),
            ),
        )
    except Exception:
        pass


# =========================================================
# USER
# =========================================================


async def get_user(user_id):
    return await db_execute(
        "SELECT * FROM users WHERE user_id=?",
        (user_id,),
        fetchone=True,
    )


async def create_user(user_id, username, first_name):
    existing = await get_user(user_id)

    if existing:
        await db_execute(
            """
            UPDATE users
            SET username=?, first_name=?
            WHERE user_id=?
            """,
            (
                username,
                first_name,
                user_id,
            ),
        )
        return False

    await db_execute(
        """
        INSERT INTO users(
            user_id,
            username,
            first_name,
            balance,
            referrals,
            videos_watched,
            is_banned,
            created_at,
            last_daily
        )
        VALUES (?, ?, ?, ?, 0, 0, 0, ?, NULL)
        """,
        (
            user_id,
            username,
            first_name,
            START_BONUS,
            datetime.now().isoformat(),
        ),
    )

    await add_log(user_id, "new_user")

    return True


async def add_balance(user_id, amount):
    await db_execute(
        """
        UPDATE users
        SET balance = balance + ?
        WHERE user_id=?
        """,
        (amount, user_id),
    )


async def remove_balance(user_id, amount):
    await db_execute(
        """
        UPDATE users
        SET balance = MAX(0, balance - ?)
        WHERE user_id=?
        """,
        (amount, user_id),
    )


async def is_banned(user_id):
    row = await db_execute(
        "SELECT is_banned FROM users WHERE user_id=?",
        (user_id,),
        fetchone=True,
    )

    return bool(row and row[0])


async def check_banned(message: Message):
    if await is_banned(message.from_user.id):
        await message.answer(
            "🚫 <b>Сіз бұғатталғансыз.</b>\n\n"
            "Администраторға хабарласыңыз."
        )
        return True

    return False


# =========================================================
# REFERRAL
# =========================================================


async def process_referral(user_id, inviter_id):
    if not inviter_id:
        return

    if inviter_id == user_id:
        return

    inviter = await get_user(inviter_id)

    if not inviter:
        return

    existing = await db_execute(
        "SELECT user_id FROM referrals WHERE user_id=?",
        (user_id,),
        fetchone=True,
    )

    if existing:
        return

    await db_execute(
        """
        INSERT INTO referrals(user_id, invited_by)
        VALUES (?, ?)
        """,
        (user_id, inviter_id),
    )

    await add_balance(inviter_id, REFERRAL_REWARD)

    await db_execute(
        """
        UPDATE users
        SET referrals=referrals+1
        WHERE user_id=?
        """,
        (inviter_id,),
    )

    await add_log(
        inviter_id,
        f"referral_reward:{REFERRAL_REWARD}",
    )


# =========================================================
# DAILY BONUS
# =========================================================


async def claim_daily(user_id):
    user = await get_user(user_id)

    if not user:
        return False, 0

    last_daily = user[8]

    now = datetime.now()

    if last_daily:
        try:
            last = datetime.fromisoformat(last_daily)

            if now.date() == last.date():
                return False, 0

        except Exception:
            pass

    await add_balance(user_id, DAILY_BONUS)

    await db_execute(
        """
        UPDATE users
        SET last_daily=?
        WHERE user_id=?
        """,
        (now.isoformat(), user_id),
    )

    await add_log(user_id, "daily_bonus")

    return True, DAILY_BONUS


# =========================================================
# VIDEOS
# =========================================================


async def get_video_count():
    row = await db_execute(
        """
        SELECT COUNT(*)
        FROM videos
        WHERE active=1
        """,
        fetchone=True,
    )

    return row[0] if row else 0


async def get_watched_count(user_id):
    row = await db_execute(
        """
        SELECT COUNT(*)
        FROM watched_videos
        WHERE user_id=?
        """,
        (user_id,),
        fetchone=True,
    )

    return row[0] if row else 0


async def reset_watched(user_id):
    await db_execute(
        "DELETE FROM watched_videos WHERE user_id=?",
        (user_id,),
    )


async def get_next_video(user_id):
    row = await db_execute(
        """
        SELECT id, file_id, title
        FROM videos
        WHERE active=1
        AND id NOT IN (
            SELECT video_id
            FROM watched_videos
            WHERE user_id=?
        )
        ORDER BY RANDOM()
        LIMIT 1
        """,
        (user_id,),
        fetchone=True,
    )

    return row


async def mark_video_watched(user_id, video_id):
    existing = await db_execute(
        """
        SELECT 1
        FROM watched_videos
        WHERE user_id=? AND video_id=?
        """,
        (
            user_id,
            video_id,
        ),
        fetchone=True,
    )

    if existing:
        return False

    await db_execute(
        """
        INSERT INTO watched_videos(
            user_id,
            video_id,
            watched_at
        )
        VALUES (?, ?, ?)
        """,
        (
            user_id,
            video_id,
            datetime.now().isoformat(),
        ),
    )

    await add_balance(user_id, VIDEO_REWARD)

    await db_execute(
        """
        UPDATE users
        SET videos_watched=videos_watched+1
        WHERE user_id=?
        """,
        (user_id,),
    )

    await add_log(
        user_id,
        f"video_reward:{video_id}",
    )

    return True


# =========================================================
# ANONYMOUS CHAT
# =========================================================


async def get_partner(user_id):
    row = await db_execute(
        """
        SELECT partner_id
        FROM anonymous_chats
        WHERE user_id=?
        """,
        (user_id,),
        fetchone=True,
    )

    return row[0] if row else None


async def remove_from_queue(user_id):
    await db_execute(
        "DELETE FROM anonymous_queue WHERE user_id=?",
        (user_id,),
    )


async def add_to_queue(user_id):
    existing = await db_execute(
        """
        SELECT 1
        FROM anonymous_queue
        WHERE user_id=?
        """,
        (user_id,),
        fetchone=True,
    )

    if not existing:
        await db_execute(
            """
            INSERT INTO anonymous_queue(
                user_id,
                created_at
            )
            VALUES (?, ?)
            """,
            (
                user_id,
                datetime.now().isoformat(),
            ),
        )


async def find_waiting_user(user_id):
    row = await db_execute(
        """
        SELECT user_id
        FROM anonymous_queue
        WHERE user_id != ?
        ORDER BY created_at
        LIMIT 1
        """,
        (user_id,),
        fetchone=True,
    )

    return row[0] if row else None


async def create_chat(user1, user2):
    await remove_from_queue(user1)
    await remove_from_queue(user2)

    await db_execute(
        """
        INSERT OR REPLACE INTO anonymous_chats(
            user_id,
            partner_id
        )
        VALUES (?, ?)
        """,
        (user1, user2),
    )

    await db_execute(
        """
        INSERT OR REPLACE INTO anonymous_chats(
            user_id,
            partner_id
        )
        VALUES (?, ?)
        """,
        (user2, user1),
    )


async def remove_chat(user_id):
    partner = await get_partner(user_id)

    await db_execute(
        "DELETE FROM anonymous_chats WHERE user_id=?",
        (user_id,),
    )

    if partner:
        await db_execute(
            "DELETE FROM anonymous_chats WHERE user_id=?",
            (partner,),
        )

    return partner


