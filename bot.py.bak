import telebot
from telebot import types
import sqlite3

# Өз мәліметтеріңізді осында жазыңыз
TOKEN = 'СІЗДІҢ_ТОКЕНІҢІЗ'
ADMIN_ID = 123456789  # Өзіңіздің Telegram ID-іңізді жазыңыз

bot = telebot.TeleBot(TOKEN)

# ----------------- БАЗА ДЕРЕКТЕРІ (SQLite) -----------------
def init_db():
    conn = sqlite3.connect('bot_database.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users
                 (user_id INTEGER PRIMARY KEY, username TEXT, balance INTEGER, referrer_id INTEGER)''')
    conn.commit()
    conn.close()

def add_user(user_id, username, referrer_id=None):
    conn = sqlite3.connect('bot_database.db')
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE user_id=?", (user_id,))
    if c.fetchone() is None:
        c.execute("INSERT INTO users (user_id, username, balance, referrer_id) VALUES (?, ?, ?, ?)",
                  (user_id, username, 0, referrer_id))
        if referrer_id:
            # Реферал шақырған адамға 50 монета қосу
            c.execute("UPDATE users SET balance = balance + 50 WHERE user_id=?", (referrer_id,))
    conn.commit()
    conn.close()

def get_user_data(user_id):
    conn = sqlite3.connect('bot_database.db')
    c = conn.cursor()
    c.execute("SELECT balance FROM users WHERE user_id=?", (user_id,))
    result = c.fetchone()
    conn.close()
    return result[0] if result else 0

# ----------------- МӘЗІРЛЕР (KEYBOARDS) -----------------
def user_menu():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    markup.add("💰 Менің балансым", "👥 Рефералдар")
    markup.add("🎁 Монета табу", "🛒 Дүкен")
    return markup

def admin_menu():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    markup.add("📊 Статистика", "📢 Рассылка")
    markup.add("💳 Монета басқару", "⬅️ Артқа")
    return markup

# ----------------- ҚОЛДАНУШЫ БҰЙРЫҚТАРЫ -----------------
@bot.message_handler(commands=['start'])
def start_command(message):
    referrer_id = None
    if len(message.text.split()) > 1:
        referrer_id = message.text.split()[1]
        if referrer_id.isdigit():
            referrer_id = int(referrer_id)

    add_user(message.from_user.id, message.from_user.username, referrer_id)
    
    bot.send_message(message.chat.id, 
                     f"Сәлем, {message.from_user.first_name}! Ботқа қош келдіңіз.", 
                     reply_markup=user_menu())

@bot.message_handler(commands=['help'])
def help_command(message):
    bot.send_message(message.chat.id, "Бұл бот арқылы монета жинап, тауарлар сатып ала аласыз.\nМәзірдегі батырмаларды қолданыңыз.")

# ----------------- АДМИН БҰЙРЫҚТАРЫ -----------------
@bot.message_handler(commands=['admin'])
def admin_command(message):
    if message.from_user.id == ADMIN_ID:
        bot.send_message(message.chat.id, "Админ-панельге қош келдіңіз!", reply_markup=admin_menu())
    else:
        bot.send_message(message.chat.id, "Кешіріңіз, сіз админ емессіз.")

# ----------------- МӘТІНДІК ХАБАРЛАМАЛАРДЫ ӨҢДЕУ -----------------
@bot.message_handler(content_types=['text'])
def handle_text(message):
    user_id = message.from_user.id
    text = message.text

    # Қолданушы батырмалары
    if text == "💰 Менің балансым":
        balance = get_user_data(user_id)
        bot.send_message(message.chat.id, f"Сіздің балансыңызда: {balance} 💰")
        
    elif text == "👥 Рефералдар":
        ref_link = f"https://t.me/{bot.get_me().username}?start={user_id}"
        bot.send_message(message.chat.id, f"Сіздің рефералдық сілтемеңіз:\n{ref_link}\n\nӘр шақырған дос үшін 50 💰 аласыз!")
        
    elif text == "🎁 Монета табу":
        bot.send_message(message.chat.id, "Монета табу үшін достарыңызды шақырыңыз немесе күнделікті тапсырмаларды орындаңыз.")
        
    elif text == "🛒 Дүкен":
        bot.send_message(message.chat.id, "Дүкен әзірге бос. Жақында тауарлар қосылады!")

    # Админ батырмалары
    elif text == "📊 Статистика" and user_id == ADMIN_ID:
        conn = sqlite3.connect('bot_database.db')
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM users")
        total_users = c.fetchone()[0]
        conn.close()
        bot.send_message(message.chat.id, f"Жалпы қолданушылар саны: {total_users} 👥")

    elif text == "📢 Рассылка" and user_id == ADMIN_ID:
        msg = bot.send_message(message.chat.id, "Рассылкаға арналған мәтінді жіберіңіз:")
        bot.register_next_step_handler(msg, process_broadcast)

    elif text == "⬅️ Артқа" and user_id == ADMIN_ID:
        bot.send_message(message.chat.id, "Негізгі мәзірге қайттыңыз.", reply_markup=user_menu())

# ----------------- РАССЫЛКА ФУНКЦИЯСЫ -----------------
def process_broadcast(message):
    text = message.text
    conn = sqlite3.connect('bot_database.db')
    c = conn.cursor()
    c.execute("SELECT user_id FROM users")
    users = c.fetchall()
    conn.close()

    success = 0
    for user in users:
        try:
            bot.send_message(user[0], text)
            success += 1
        except:
            pass # Егер қолданушы ботты бұғаттап тастаса, қате шықпау үшін

    bot.send_message(message.chat.id, f"Рассылка аяқталды! {success} адамға хат жіберілді.")

# Ботты іске қосу
if __name__ == '__main__':
    init_db()
    print("Бот іске қосылды...")
    bot.infinity_polling()
